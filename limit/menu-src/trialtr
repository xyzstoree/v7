red() { echo -e "\\033[32;1m${*}\\033[0m"; }
# Getting
CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
export TIME="10"
export URL="https://api.telegram.org/bot$KEY/sendMessage"
clear
#IZIN SCRIPT
MYIP=$(curl -sS ipv4.icanhazip.com)

clear
# Valid Script
ipsaya=$(wget -qO- ipinfo.io/ip)
data_server=$(curl -v --insecure --silent https://google.com/ 2>&1 | grep Date | sed -e 's/< Date: //')
date_list=$(date +"%Y-%m-%d" -d "$data_server")
clear
domain=$(cat /etc/xray/domain)
Quota=1
iplimit=10
for _try in 1 2 3 4 5; do
    user="Trial-TR$(</dev/urandom tr -dc A-Za-z0-9 | head -c6)"
    grep -qE "^//tr ${user} " /etc/xray/config.json || break
done
clear
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;96m           Set Durasi Trial              \033[0m"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e " Contoh  : 30m = 30 menit | 2h = 2 jam | 1d = 1 hari"
read -p " Durasi  : " DURATION_INPUT
DURATION_INPUT="${DURATION_INPUT:-30m}"
DUR_NUM="${DURATION_INPUT%[mhd]}"
DUR_UNIT="${DURATION_INPUT: -1}"
case "$DUR_UNIT" in
  m) DURATION_MIN="$DUR_NUM"; EXPIRE_DISPLAY="${DUR_NUM} Menit" ;;
  h) DURATION_MIN="$((DUR_NUM * 60))"; EXPIRE_DISPLAY="${DUR_NUM} Jam" ;;
  d) DURATION_MIN="$((DUR_NUM * 1440))"; EXPIRE_DISPLAY="${DUR_NUM} Hari" ;;
  *) DURATION_MIN="1440"; EXPIRE_DISPLAY="1 Hari" ;;
esac
masaaktif=$(( (DURATION_MIN + 1439) / 1440 ))
[ "$masaaktif" -lt 1 ] && masaaktif=1
clear
uuid=$(cat /proc/sys/kernel/random/uuid)
exp=$(date -d "$masaaktif days" +"%Y-%m-%d")
tgl=$(date -d "$masaaktif days" +"%d")
bln=$(date -d "$masaaktif days" +"%b")
thn=$(date -d "$masaaktif days" +"%Y")
expe="$tgl $bln, $thn"
tgl2=$(date +"%d")
bln2=$(date +"%b")
thn2=$(date +"%Y")
tnggl="$tgl2 $bln2, $thn2"
sed -i '/#trojanws$/a\//tr '"$user $exp"'\
},{"password": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
sed -i '/#trojangrpc$/a\//tr '"$user $exp"'\
},{"password": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
# Link Trojan Akun
systemctl reload xray
/usr/local/sbin/xyz-disconnect-user "$user" trojan >/dev/null 2>&1
trojanlink1="trojan://${uuid}@${domain}:443?mode=gun&security=tls&type=grpc&serviceName=trojan-grpc&sni=${domain}#${user}"
trojanlink="trojan://${uuid}@${domain}:443?path=%2Ftrojan-ws&security=tls&host=${domain}&type=ws&sni=${domain}#${user}"

cat >/var/www/html/trojan-$user.txt <<-END
◇━━━━━━━━━━━━━━━━━◇
  ZN TUNNELING
◇━━━━━━━━━━━━━━━━━◇
 
# Format Trojan GO/WS

- name: Trojan-$user-GO/WS
  server: ${domain}
  port: 443
  type: trojan
  password: ${uuid}
  network: ws
  sni: ${domain}
  skip-cert-verify: true
  udp: true
  ws-opts:
    path: /trojan-ws
    headers:
        Host: ${domain}

# Format Trojan gRPC

- name: Trojan-$user-gRPC
  type: trojan
  server: ${domain}
  port: 443
  password: ${uuid}
  udp: true
  sni: ${domain}
  skip-cert-verify: true
  network: grpc
  grpc-opts:
    grpc-service-name: trojan-grpc

◇━━━━━━━━━━━━━━━━━◇
Link Akun Trojan 
◇━━━━━━━━━━━━━━━━━◇
Link WS          : 
${trojanlink}
◇━━━━━━━━━━━━━━━━━◇
Link GRPC        : 
${trojanlink1}
◇━━━━━━━━━━━━━━━━━◇
"

END

# Hapus `service cron restart` (tidak relevan untuk at-job; at dilayani atd, bukan cron).
trojanlink="trojan://${uuid}@${domain}:443?path=%2Ftrojan-ws&security=tls&host=${domain}&type=ws&sni=${domain}#${user}"
trojanlink1="trojan://${uuid}@${domain}:443?mode=gun&security=tls&type=grpc&serviceName=trojan-grpc&sni=${domain}#${user}"
if [ ! -e /etc/trojan ]; then
  mkdir -p /etc/trojan
fi

if [[ $iplimit -gt 0 ]]; then
mkdir -p /etc/kyt/limit/trojan/ip
echo -e "$iplimit" > /etc/kyt/limit/trojan/ip/$user
else
echo > /dev/null
fi

if [ -z ${Quota} ]; then
  Quota="0"
fi

c=$(echo "${Quota}" | sed 's/[^0-9]*//g')
d=$((${c} * 1024 * 1024 * 1024))

if [[ ${c} != "0" ]]; then
  echo "${d}" >/etc/trojan/${user}
fi
u_esc_pre=$(printf '%s' "$user" | sed 's/[].\/*^$[]/\\&/g')
sed -i -E "/^### ${u_esc_pre}( |\$)/d" /etc/trojan/.trojan.db
echo "### ${user} ${exp} ${uuid} ${Quota} ${iplimit}" >>/etc/trojan/.trojan.db
systemctl enable atd >/dev/null 2>&1; systemctl start atd >/dev/null 2>&1
# At-job: anchor end-of-line, force-disconnect, reload.
echo "/usr/local/sbin/xyz-trial-cleanup trojan '${user}' '${exp}'" | at now + ${DURATION_MIN} minutes
clear
CHATID="$CHATID"
KEY="$KEY"
TIME="$TIME"
URL="$URL"
TEXT="
◇━━━━━━━━━━━━━━━━━━━━━━━◇
<b>     XRAY/TROJAN SUCCES </b>
◇━━━━━━━━━━━━━━━━━━━━━━━◇
