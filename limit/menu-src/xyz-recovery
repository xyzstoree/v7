#!/bin/bash
# xyz-recovery — Recovery cepat kalau xray offline.
# Usage: bash xyz-recovery
#       atau: bash <(curl -sL https://raw.githubusercontent.com/xyzstoree/v7/main/limit/menu-src/xyz-recovery)
#
# Aksi:
#   1. Cek status xray.
#   2. Cek backup tersedia.
#   3. Validate config saat ini. Kalau valid syntax tapi ada permission
#      issue (misalnya 0600 root-only — bug yang sempat ada di
#      xyz-xray-tag-migrate versi pertama), auto-fix permission.
#   4. Kalau config rusak, restore dari backup terbaru yang valid.
#   5. Restart xray, verify aktif.

set -u
CONF="/etc/xray/config.json"
XRAY_BIN="${XRAY_BIN:-/usr/local/bin/xray}"
[ -x "$XRAY_BIN" ] || XRAY_BIN="$(command -v xray 2>/dev/null || echo /usr/local/bin/xray)"

restart_and_verify() {
    systemctl daemon-reload
    systemctl restart xray
    sleep 3
    if systemctl is-active --quiet xray; then
        echo "OK xray ACTIVE."
        systemctl status xray --no-pager | head -8
        return 0
    fi
    echo "FAIL xray masih offline. Detail journalctl:"
    journalctl -u xray -n 30 --no-pager
    return 1
}

echo ">>> [1/5] Cek status xray sekarang..."
systemctl status xray --no-pager 2>/dev/null | head -10
echo ""

echo ">>> [2/5] Cek backup tersedia..."
LATEST_BAK=$(ls -t "${CONF}".bak.* 2>/dev/null | head -n1)
if [ -n "$LATEST_BAK" ]; then
    echo "Backup ditemukan: $LATEST_BAK"
    ls -la "$LATEST_BAK"
else
    echo "Tidak ada backup di ${CONF}.bak.* — recovery hanya bisa fix"
    echo "permission, tidak bisa restore content."
fi
echo ""

echo ">>> [3/5] Validate config saat ini..."
if "$XRAY_BIN" test -config "$CONF" >/tmp/xyz-recovery.log 2>&1; then
    echo "Config syntax VALID. Cek permission..."
    # xray.service jalan sebagai www-data, bukan root. `xray test` di-run
    # sebagai root jadi tidak akan ketauan kalau file 0600 root-only.
    if ! sudo -u www-data test -r "$CONF" 2>/dev/null; then
        echo "PERMISSION ISSUE: user www-data tidak bisa baca $CONF"
        ls -la "$CONF"
        echo "Auto-fix: chmod 0644 + chown root:root..."
        chmod 0644 "$CONF"
        chown root:root "$CONF"
        ls -la "$CONF"
        echo ""
        echo ">>> [5/5] Restart xray..."
        if restart_and_verify; then
            exit 0
        fi
    else
        echo "Permission OK. Config seharusnya bisa di-load xray."
        echo ""
        echo ">>> [5/5] Restart xray..."
        if restart_and_verify; then
            exit 0
        fi
    fi
else
    echo "Config saat ini INVALID. Detail error:"
    tail -n 15 /tmp/xyz-recovery.log
fi
echo ""

if [ -z "$LATEST_BAK" ]; then
    echo "Tidak ada backup untuk restore. Coba reinstall:"
    echo "  bash <(curl -sL https://raw.githubusercontent.com/xyzstoree/v7/main/install.sh)"
    exit 1
fi

echo ">>> [4/5] Validate backup..."
if "$XRAY_BIN" test -config "$LATEST_BAK" >/tmp/xyz-recovery.log 2>&1; then
    echo "Backup VALID. Restoring..."
    cp -p "$CONF" "${CONF}.broken.$(date +%Y%m%d-%H%M%S)" 2>/dev/null
    cp -p "$LATEST_BAK" "$CONF"
    chmod 0644 "$CONF"
    chown root:root "$CONF"
    echo "Config rusak disimpan ke ${CONF}.broken.* untuk debug nanti."
else
    echo "Backup juga INVALID. Detail:"
    tail -n 15 /tmp/xyz-recovery.log
    echo ""
    echo "Cari backup lebih lama:"
    ls -la "${CONF}".bak.* 2>/dev/null
    echo ""
    echo "Coba restore manual dari salah satu backup di atas:"
    echo "  cp /etc/xray/config.json.bak.<TANGGAL> /etc/xray/config.json"
    echo "  chmod 0644 /etc/xray/config.json"
    echo "  chown root:root /etc/xray/config.json"
    echo "  systemctl restart xray"
    exit 1
fi
echo ""

echo ">>> [5/5] Restart xray..."
if restart_and_verify; then
    exit 0
fi
exit 1
