#!/bin/bash
# xyz-recovery — Recovery + ensure zero-drop konfiguration.
# Usage: bash xyz-recovery
#       atau: bash <(curl -sL https://raw.githubusercontent.com/xyzstoree/v7/main/limit/menu-src/xyz-recovery)
#
# Aksi:
#   1. Cek status xray + auto-fix permission/restore dari backup kalau perlu.
#   2. HAPUS ExecReload dari xray.service (mencegah HUP-induced restart
#      dari skrip lama yang masih panggil `systemctl reload xray`).
#   3. OVERRIDE semua skrip user-management dari source repo (versi
#      zero-drop) — supaya tidak bergantung pada menu.zip yang mungkin
#      tertinggal.

set -u
CONF="/etc/xray/config.json"
XRAY_BIN="${XRAY_BIN:-/usr/local/bin/xray}"
[ -x "$XRAY_BIN" ] || XRAY_BIN="$(command -v xray 2>/dev/null || echo /usr/local/bin/xray)"
REPO_RAW="https://raw.githubusercontent.com/xyzstoree/v7/main/limit/menu-src"

restart_and_verify() {
    systemctl daemon-reload
    systemctl restart xray
    sleep 3
    if systemctl is-active --quiet xray; then
        echo "OK xray ACTIVE."
        return 0
    fi
    echo "FAIL xray masih offline. Detail journalctl:"
    journalctl -u xray -n 30 --no-pager
    return 1
}

ensure_zero_drop_config() {
    echo ">>> Memastikan konfigurasi zero-drop..."
    # 1. Hapus ExecReload — supaya `systemctl reload xray` jadi no-op
    #    (return error tapi gak restart). Skrip lama yg masih panggil
    #    reload tidak akan bikin drop.
    if grep -q '^ExecReload=' /etc/systemd/system/xray.service 2>/dev/null; then
        echo "    - Hapus ExecReload dari /etc/systemd/system/xray.service"
        sed -i '/^ExecReload=/d' /etc/systemd/system/xray.service
        systemctl daemon-reload
    else
        echo "    - ExecReload sudah tidak ada. OK."
    fi

    # 2. Override semua skrip user-management dari source repo. Pastikan
    #    versi yg dipakai = source terbaru (sudah migrate ke gRPC API).
    echo "    - Override skrip user-management dari ${REPO_RAW}..."
    local OVERRIDE_LIST=(
        xyz-xray-user xyz-xray-sync xyz-xray-tag-migrate
        addws addvless addtr addss
        delws delvless deltr delss
        renewws renewvless renewtr renewss
        trialws trialvless trialtr trialss
        m-vmess m-vless m-trojan
        xyz-trial-cleanup xp cektr
    )
    local ok=0 fail=0
    for f in "${OVERRIDE_LIST[@]}"; do
        if wget --timeout=30 --tries=2 -q -O "/usr/local/sbin/$f" \
                "${REPO_RAW}/$f" 2>/dev/null; then
            chmod +x "/usr/local/sbin/$f" 2>/dev/null
            ok=$((ok+1))
        else
            fail=$((fail+1))
        fi
    done
    echo "      Override: $ok ok, $fail gagal."
}

echo ">>> [1/4] Cek status xray sekarang..."
systemctl status xray --no-pager 2>/dev/null | head -10
echo ""

echo ">>> [2/4] Cek backup tersedia..."
LATEST_BAK=$(ls -t "${CONF}".bak.* 2>/dev/null | head -n1)
if [ -n "$LATEST_BAK" ]; then
    echo "Backup ditemukan: $LATEST_BAK"
    ls -la "$LATEST_BAK"
else
    echo "Tidak ada backup di ${CONF}.bak.*"
fi
echo ""

echo ">>> [3/4] Validate config + permission..."
if "$XRAY_BIN" test -config "$CONF" >/tmp/xyz-recovery.log 2>&1; then
    echo "Config syntax VALID."
    if ! sudo -u www-data test -r "$CONF" 2>/dev/null; then
        echo "PERMISSION ISSUE: user www-data tidak bisa baca $CONF"
        ls -la "$CONF"
        echo "Auto-fix: chmod 0644 + chown root:root..."
        chmod 0644 "$CONF"
        chown root:root "$CONF"
    fi
else
    echo "Config INVALID. Detail:"
    tail -n 15 /tmp/xyz-recovery.log
    echo ""
    if [ -n "$LATEST_BAK" ] && "$XRAY_BIN" test -config "$LATEST_BAK" >/dev/null 2>&1; then
        echo "Restoring dari $LATEST_BAK..."
        cp -p "$CONF" "${CONF}.broken.$(date +%Y%m%d-%H%M%S)" 2>/dev/null
        cp -p "$LATEST_BAK" "$CONF"
        chmod 0644 "$CONF"
        chown root:root "$CONF"
    else
        echo "Tidak ada backup valid. Coba reinstall:"
        echo "  bash <(curl -sL https://raw.githubusercontent.com/xyzstoree/v7/main/install.sh)"
        exit 1
    fi
fi
echo ""

echo ">>> [4/4] Apply zero-drop config + restart..."
ensure_zero_drop_config
echo ""
if restart_and_verify; then
    echo ""
    echo "Recovery selesai. xray jalan, ExecReload sudah dihapus, skrip"
    echo "user-management sudah ditimpa dengan versi zero-drop."
    exit 0
fi
exit 1
