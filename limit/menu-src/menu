# Counter akun: gunakan prefix marker yang benar-benar ditulis oleh add*
# scripts ke /etc/xray/config.json (//vl /vm /tr /ss). Versi lama grep
# prefix yang TIDAK PERNAH ada di config (#& ### #! #ss#) sehingga counter
# selalu 0. Setiap akun ditulis 2x (ws inbound + grpc inbound) → /2.
vlx=$(grep -c -E "^//vl " "/etc/xray/config.json" 2>/dev/null); let vla=$vlx/2
vmc=$(grep -c -E "^//vm " "/etc/xray/config.json" 2>/dev/null); let vma=$vmc/2
trx=$(grep -c -E "^//tr " "/etc/xray/config.json" 2>/dev/null); let trb=$trx/2
ssx=$(grep -c -E "^//ss " "/etc/xray/config.json" 2>/dev/null); let ssa=$ssx/2
# SSH count: prefer DB (presisi, hanya akun yang dibuat lewat addssh/trial).
# Fallback ke awk /etc/passwd untuk backward-compat (over-count kalau ada
# admin user manual, tapi lebih akurat dari nol).
if [ -f /etc/ssh/.ssh.db ]; then
    ssh1=$(grep -cE "^#ssh# " /etc/ssh/.ssh.db 2>/dev/null)
else
    ssh1=$(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | wc -l)
fi
r="\033[1;31m"  #REDTERANG
DROPBEAR_VERSION=$(dropbear -V 2>&1 | grep -oE 'v[0-9.]+')
XRAY_VERSION=$(xray version 2>/dev/null | head -n 1 | awk '{print $2}')
# vnStat parsing: pick usable interface (route default -> vnstat iflist -> eth0).
VN_IFACE=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')
if ! vnstat -i "$VN_IFACE" >/dev/null 2>&1; then
  VN_IFACE=$(vnstat --iflist 2>/dev/null | awk -F'[:( ]+' '/available interfaces/ {print $3; exit}')
fi
[ -z "$VN_IFACE" ] && VN_IFACE="eth0"

# vnStat v2 parser via grep+set (more robust across awk variants/locales).
vnstat_m_out=$(vnstat -m -i "$VN_IFACE" 2>/dev/null)
vnstat_d_out=$(vnstat -d -i "$VN_IFACE" 2>/dev/null)
month_row=$(printf "%s\n" "$vnstat_m_out" | grep -E -m1 '^[[:space:]]*[0-9]{4}-[0-9]{2}[[:space:]]')
if [ -n "$month_row" ]; then
  set -- $month_row
  month_line="$1"
  month_rx="$2 $3"
  month_tx="$5 $6"
  month_total="$8 $9"
fi

day_row=$(printf "%s\n" "$vnstat_d_out" | grep -E -m1 '^[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]')
if [ -n "$day_row" ]; then
  set -- $day_row
  day_line="$1"
  day_rx="$2 $3"
  day_tx="$5 $6"
  day_total="$8 $9"
fi

# Fallback for legacy vnStat output (old scripts expected bracket format).
[ -z "$month_line" ] && month_line=$(printf "%s\n" "$vnstat_m_out" | awk '/\[/ {print $2" "$3; exit}')
[ -z "$month_rx" ] && month_rx=$(printf "%s\n" "$vnstat_m_out" | awk '/\[/ {print $4" "$5; exit}')
[ -z "$month_tx" ] && month_tx=$(printf "%s\n" "$vnstat_m_out" | awk '/\[/ {print $7" "$8; exit}')
[ -z "$month_total" ] && month_total=$(printf "%s\n" "$vnstat_m_out" | awk '/\[/ {print $10" "$11; exit}')
[ -z "$day_line" ] && day_line=$(printf "%s\n" "$vnstat_d_out" | awk '/\[/ {print $2" "$3; exit}')
[ -z "$day_rx" ] && day_rx=$(printf "%s\n" "$vnstat_d_out" | awk '/\[/ {print $4" "$5; exit}')
[ -z "$day_tx" ] && day_tx=$(printf "%s\n" "$vnstat_d_out" | awk '/\[/ {print $7" "$8; exit}')
[ -z "$day_total" ] && day_total=$(printf "%s\n" "$vnstat_d_out" | awk '/\[/ {print $10" "$11; exit}')
# Some vnStat builds reject 1-second sampling, so try 2s then fallback 5s.
vn_tr_raw=$(vnstat -tr 2 -i "$VN_IFACE" 2>/dev/null)
[ -z "$vn_tr_raw" ] && vn_tr_raw=$(vnstat -tr 5 -i "$VN_IFACE" 2>/dev/null)
# Parse live traffic rate robustly across vnStat output variants.
day_trf=$(printf "%s\n" "$vn_tr_raw" | awk '/traffic/ {for(i=1;i<=NF;i++) if($i ~ /bit\/s$/){print $(i-1)" "$i; exit}}')
[ -z "$day_trf" ] && day_trf=$(printf "%s\n" "$vn_tr_raw" | awk '{for(i=1;i<=NF;i++) if($i ~ /bit\/s$/){print $(i-1)" "$i; exit}}')
[ -z "$day_trf" ] && day_trf=$(printf "%s\n" "$vn_tr_raw" | awk '/rx/ {print $2" "$3; exit}')
[ -z "$day_trf" ] && day_trf=$(printf "%s\n" "$vn_tr_raw" | awk '/fwd/ {print $2" "$3; exit}')
[ -z "$day_trf" ] && day_trf="N/A"

# Make display closer to Potato style: show total with [Month]/[DayName]
month_name=$(date -d "${month_line}-01" +%B 2>/dev/null)
day_name=$(date -d "${day_line}" +%A 2>/dev/null)
[ -z "$month_name" ] && month_name="$month_line"
[ -z "$day_name" ] && day_name="$day_line"
month_show="$month_total [$month_name]"
day_show="$day_total [$day_name]"
[ -z "$month_line" ] && month_line="N/A"
[ -z "$month_rx" ] && month_rx="N/A"
[ -z "$month_tx" ] && month_tx="N/A"
[ -z "$month_total" ] && month_total="N/A"
[ -z "$day_line" ] && day_line="N/A"
[ -z "$day_rx" ] && day_rx="N/A"
[ -z "$day_tx" ] && day_tx="N/A"
[ -z "$day_total" ] && day_total="N/A"
[ -z "$day_trf" ] && day_trf="N/A"
[ -z "$month_show" ] && month_show="N/A"
[ -z "$day_show" ] && day_show="N/A"

# Small health tag at right side, like Potato.
if [ "$status_xray_txt" = "ON" ] && [ "$status_ws_txt" = "ON" ] && [ "$status_haproxy_txt" = "ON" ]; then
  system_health="${GREEN}GOOD   ${NC}"
else
