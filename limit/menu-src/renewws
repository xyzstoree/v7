#!/bin/bash
# Renew akun VMess. Lihat catatan fix di renewvless.
red='\e[1;31m'
green='\e[0;36m'
NC='\e[0m'
green() { echo -e "\\033[32;1m${*}\\033[0m"; }
red() { echo -e "\\033[31;1m${*}\\033[0m"; }

clear

NUMBER_OF_CLIENTS=$(grep -c -E "^//vm " "/etc/xray/config.json")
if [[ ${NUMBER_OF_CLIENTS} == '0' ]]; then
    clear
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "           Renew Vmess          \E[0m"
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    echo "You have no existing clients!"
    echo ""
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    read -n 1 -s -r -p "Press any key to back on menu"
    menu
fi

clear
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "           Renew Vmess          \E[0m"
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
grep -E "^//vm " "/etc/xray/config.json" | cut -d ' ' -f 2-3 | column -t | sort | uniq
echo ""
red "tap enter to go back"
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
read -rp "Input Username : " user
if [ -z "$user" ]; then
    menu
    exit 0
fi

read -p "Expired (days): " masaaktif
read -p "Limit User (GB): " Quota
read -p "Limit User (IP): " iplim

[[ "$masaaktif" =~ ^[1-9][0-9]*$ ]] || { red "Masa aktif harus angka positif."; sleep 2; menu; exit 0; }
[[ "$Quota"     =~ ^[0-9]+$        ]] || Quota=0
[[ "$iplim"     =~ ^[0-9]+$        ]] || iplim=0

exp=$(grep -E "^//vm ${user} " /etc/xray/config.json | head -n1 | cut -d ' ' -f 3)
if [ -z "$exp" ]; then
    red "User VMESS '$user' tidak ditemukan."
    sleep 2
    menu
    exit 0
fi

mkdir -p /etc/kyt/limit/vmess/ip /etc/vmess

if [[ $iplim -gt 0 ]]; then
    echo "$iplim" > /etc/kyt/limit/vmess/ip/${user}
else
    rm -f /etc/kyt/limit/vmess/ip/${user}
fi

c=$(echo "${Quota}" | sed 's/[^0-9]*//g')
[ -z "$c" ] && c=0
d=$(( c * 1024 * 1024 * 1024 ))
if [[ ${c} != "0" ]]; then
    echo "${d}" > /etc/vmess/${user}
else
    rm -f /etc/vmess/${user}
fi

now=$(date +%s)
old_sec=$(date -d "$exp" +%s 2>/dev/null || echo "$now")
exp2=$(( (old_sec - now) / 86400 ))
[ "$exp2" -lt 0 ] && exp2=0
exp_total=$(( exp2 + masaaktif ))
exp4=$(date -d "$exp_total days" +"%Y-%m-%d")

u_esc=$(printf '%s' "$user" | sed 's/[].\/*^$[]/\\&/g')
e_esc=$(printf '%s' "$exp"  | sed 's/[].\/*^$[]/\\&/g')

sed -i "/^\/\/vm ${u_esc} ${e_esc}\$/c\\//vm $user $exp4" /etc/xray/config.json

if [ -f /etc/vmess/.vmess.db ]; then
    sed -i -E "s|^### ${u_esc} ${e_esc} ([^ ]+) [^ ]+ [^ ]+\$|### $user $exp4 \\1 ${Quota} ${iplim}|" /etc/vmess/.vmess.db
fi

# Renew = cuma update tanggal/quota. UUID tidak berubah, runtime user state
# di Xray tetap valid → tidak perlu reload/restart.
clear
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo " VMESS Account Was Successfully Renewed"
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
echo " Client Name   : $user"
echo " Expired On    : $exp4"
echo " User Quota    : $Quota GB"
echo " User Limit IP : $iplim"
echo ""
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
read -n 1 -s -r -p "Press any key to back on menu"
menu
