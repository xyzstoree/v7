#!/bin/bash
# Renew akun Shadowsocks.
# FIX:
#   - Clamp exp2 supaya tidak negatif (akun expired tetap expired setelah renew).
#   - Sed pattern di-anchor.
#   - Update DB di path yang benar (.shadowsocks.db).
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;36m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
red() { echo -e "\\033[31;1m${*}\\033[0m"; }
clear

NUMBER_OF_CLIENTS=$(grep -c -E "^//ss " "/etc/xray/config.json")
if [[ ${NUMBER_OF_CLIENTS} == '0' ]]; then
    clear
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "          Renew Shadowsocks       \E[0m"
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    echo "You have no existing clients!"
    echo ""
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    read -n 1 -s -r -p "Press any key to back on menu"
    menu
fi

clear
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "         Renew Shadowsocks         \E[0m"
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
grep -E "^//ss " "/etc/xray/config.json" | cut -d ' ' -f 2-3 | column -t | sort | uniq
echo ""
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
read -rp "Input Username : " user
if [ -z "$user" ]; then
    menu
    exit 0
fi

read -p "Expired (days): " masaaktif
[[ "$masaaktif" =~ ^[1-9][0-9]*$ ]] || { red "Masa aktif harus angka positif."; sleep 2; menu; exit 0; }

exp=$(grep -E "^//ss ${user} " /etc/xray/config.json | head -n1 | cut -d ' ' -f 3)
if [ -z "$exp" ]; then
    red "User SS '$user' tidak ditemukan."
    sleep 2
    menu
    exit 0
fi

now=$(date +%s)
old_sec=$(date -d "$exp" +%s 2>/dev/null || echo "$now")
exp2=$(( (old_sec - now) / 86400 ))
[ "$exp2" -lt 0 ] && exp2=0
exp_total=$(( exp2 + masaaktif ))
exp4=$(date -d "$exp_total days" +"%Y-%m-%d")

u_esc=$(printf '%s' "$user" | sed 's/[].\/*^$[]/\\&/g')
e_esc=$(printf '%s' "$exp"  | sed 's/[].\/*^$[]/\\&/g')

sed -i "/^\/\/ss ${u_esc} ${e_esc}\$/c\\//ss $user $exp4" /etc/xray/config.json

if [ -f /etc/shadowsocks/.shadowsocks.db ]; then
    sed -i -E "s|^### ${u_esc} ${e_esc} (.*)\$|### $user $exp4 \\1|" /etc/shadowsocks/.shadowsocks.db
fi

# Renew = cuma update tanggal. Password tidak berubah, runtime user state
# di Xray tetap valid → tidak perlu reload/restart.
clear
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo " Shadowsocks Account Was Successfully Renewed"
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
echo " Client Name : $user"
echo " Expired On  : $exp4"
echo ""
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
read -n 1 -s -r -p "Press any key to back on menu"
menu
