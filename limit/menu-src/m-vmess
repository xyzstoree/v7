###lock vmwss
function lock() {
    clear
    echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
    echo -e "$COLOR1│${NC} ${COLBG1}             • LOCK XRAY USER •              ${NC} $COLOR1│$NC"
    echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
    read -rp "   Input Username for lock: " user

    if [ -z "$user" ]; then
        m-vmess
    else
        local exp u_esc e_esc already
        # Ambil exp pakai awk (anchored pada $1=="###" && $2==user) supaya tidak partial-match
        exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3}' /etc/vmess/.vmess.db)
        if [ -z "$exp" ]; then
            echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
            echo -e "$COLOR1│${NC}   • User not found in database."
            echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
        else
            u_esc=$(printf '%s' "$user" | sed 's/[].\/*^$[]/\\&/g')
            e_esc=$(printf '%s' "$exp"  | sed 's/[].\/*^$[]/\\&/g')
            already=$(grep -cE "^//vm ${u_esc} ${e_esc}\$" /etc/xray/config.json)
            if [ "$already" -eq 0 ]; then
                echo -e "$COLOR1│${NC}   • User ${user} sudah dalam status locked."
            else
                # Hapus dari xray config dengan prefix //vm yang BENAR (bukan ###)
                sed -i "/^\/\/vm ${u_esc} ${e_esc}\$/,/^},{/d" /etc/xray/config.json
                # Lock = matikan user di runtime via API, lalu kick socket
                # aktif. Tidak pakai reload xray (zero-drop user lain).
                /usr/local/sbin/xyz-xray-user del vmess "$user" >/dev/null 2>&1
                /usr/local/sbin/xyz-disconnect-user "$user" vmess >/dev/null 2>&1
            fi

            clear
            echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
            echo -e "$COLOR1│${NC} ${COLBG1}             • LOCKED XRAY USER •            ${NC} $COLOR1│$NC"
            echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
            echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
            echo -e "$COLOR1│${NC}   • Account locked successfully."
            echo -e "$COLOR1│${NC}   • Client Name : $user"
            echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
        fi
        echo -e ""
        read -n 1 -s -r -p "   Press any key to back on menu"
        m-vmess
    fi
}

###unlok vmess
function unlock(){
clear
echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
echo -e "$COLOR1│${NC} ${COLBG1}             • UNLOCK XRAY USER •              ${NC} $COLOR1│$NC"
echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
read -rp "   Input Username for unlock: " user
if [ -z "$user" ]; then
    m-vmess
else
    # Ambil exp & uuid via awk (anchored) supaya tidak partial-match user lain
    exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3}' /etc/vmess/.vmess.db)
    uuid=$(awk -v u="$user" '$1=="###" && $2==u {print $4}' /etc/vmess/.vmess.db)
    if [ -z "$uuid" ] || [ -z "$exp" ]; then
        echo "User tidak ditemukan di /etc/vmess/.vmess.db."
        echo "Catatan: unlock TIDAK akan generate UUID baru karena akan memutus client."
        echo ""
        read -n 1 -s -r -p "   Press any key to back on menu"
        m-vmess
        return
    fi
    u_esc=$(printf '%s' "$user" | sed 's/[].\/*^$[]/\\&/g')
    e_esc=$(printf '%s' "$exp"  | sed 's/[].\/*^$[]/\\&/g')
    # Idempoten: jangan dobel-insert kalau user masih ada di config
    already=$(grep -cE "^//vm ${u_esc} ${e_esc}\$" /etc/xray/config.json)
    if [ "$already" -gt 0 ]; then
        clear
        echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
        echo -e "$COLOR1│${NC}   • User ${user} sudah dalam status unlocked."
        echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
        echo ""
        read -n 1 -s -r -p "   Press any key to back on menu"
        m-vmess
        return
    fi
    # Insert ulang dengan prefix //vm yang BENAR (komentar JSONC valid)
    sed -i '/#vmess$/a\//vm '"$user $exp"'\
},{"id": "'""$uuid""'","alterId": '"0"',"email": "'""$user""'"' /etc/xray/config.json
    sed -i '/#vmessgrpc$/a\//vm '"$user $exp"'\
},{"id": "'""$uuid""'","alterId": '"0"',"email": "'""$user""'"' /etc/xray/config.json
    # Unlock = aktifkan kembali user di runtime via API (zero-drop).
    /usr/local/sbin/xyz-xray-user add vmess "$user" "$uuid" >/dev/null 2>&1
    clear
    echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
    echo -e "$COLOR1│${NC} ${COLBG1}             • UNLOCKED XRAY USER •          ${NC} $COLOR1│$NC"
    echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
    echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
    echo -e "$COLOR1│${NC}   • Accound unlocked Successfully"
    echo -e "$COLOR1\033[0;34m│${NC}"
    echo -e "$COLOR1│${NC}   • Client Name : $user"
    echo -e "$COLOR1│${NC}   • Expired On  : $exp"
    echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
    echo ""
    read -n 1 -s -r -p "   Press any key to back on menu"
    m-vmess
fi
}
### change uuid
function change(){
clear
NUMBER_OF_CLIENTS=$(grep -c -E "^//vm " "/etc/xray/config.json")
if [[ ${NUMBER_OF_CLIENTS} == '0' ]]; then
echo ""
echo ""
echo "You have no existing clients!" 
echo "" 
echo ""
read -n 1 -s -r -p "Press any key to back on menu"
menu
fi

clear
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "           Change uuid Vmess          \E[0m"
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
grep -E "^//vm " "/etc/xray/config.json" | cut -d ' ' -f 2 | column -t | sort | uniq
echo ""
red "tap enter to go back"
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
read -rp "Input Username : " user
if [ -z "$user" ]; then
menu
else
read -p "Input uuid baru / input new uuid : " uuid
[ -z "$uuid" ] && menu && return
exp=$(awk -v u="$user" '$1=="//vm" && $2==u {print $3}' /etc/xray/config.json | sort -u | head -n1)
if [ -z "$exp" ]; then
    echo "User $user tidak ditemukan di config xray."
    read -n 1 -s -r -p "Press any key to back on menu"
    m-vmess
    return
fi
u_esc=$(printf '%s' "$user" | sed 's/[].\/*^$[]/\\&/g')
e_esc=$(printf '%s' "$exp"  | sed 's/[].\/*^$[]/\\&/g')

sed -i "/^\/\/vm ${u_esc} ${e_esc}\$/,/^},{/d" /etc/xray/config.json

sed -i '/#vmess$/a\//vm '"$user $exp"'\
},{"id": "'""$uuid""'","alterId": '"0"',"email": "'""$user""'"' /etc/xray/config.json
sed -i '/#vmessgrpc$/a\//vm '"$user $exp"'\
},{"id": "'""$uuid""'","alterId": '"0"',"email": "'""$user""'"' /etc/xray/config.json

# Update DB juga supaya unlock berikutnya pakai uuid baru
sed -i -E "s|^### ${u_esc} ${e_esc} [^ ]+ |### $user $exp $uuid |" /etc/vmess/.vmess.db

# Change UUID: rm runtime user lama, add yg baru, kick socket aktif supaya
# client reconnect dengan UUID baru. Zero-drop untuk user lain.
/usr/local/sbin/xyz-xray-user del vmess "$user"           >/dev/null 2>&1
/usr/local/sbin/xyz-xray-user add vmess "$user" "$uuid"   >/dev/null 2>&1
/usr/local/sbin/xyz-disconnect-user "$user" vmess         >/dev/null 2>&1

clear
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo " VMESS Account Was Successfully Edited"
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
echo " Client Name  : $user"
echo " Uuid baru  : $uuid"
echo ""
echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
fi
}
