#!/bin/bash
# Tendang multilogin SSH/Dropbear yang melebihi MAX.
# FIX UTAMA:
#   - Sebelumnya skrip ini menjalankan `userdel -f $user` di awal (sebelum $user
#     terdefinisi) dan setelah loop. Itu menyebabkan: (a) penghapusan permanen
#     user yang multilogin (bukan sekedar kick), dan (b) `service ssh restart`
#     yang memutus SEMUA koneksi SSH user lain setiap kali cron berjalan.
#   - Sekarang: cuma `kill` PID koneksi yang melanggar. User TIDAK dihapus,
#     service ssh TIDAK di-restart.
clear
MAX=1
LOG=""
OS=0
if [ -e "/var/log/auth.log" ]; then
    OS=1
    LOG="/var/log/auth.log"
elif [ -e "/var/log/secure" ]; then
    OS=2
    LOG="/var/log/secure"
fi

if [ -z "$LOG" ]; then
    echo "Tidak menemukan log SSH (/var/log/auth.log atau /var/log/secure)."
    exit 1
fi

if [[ ${1+x} ]]; then
    MAX=$1
fi

cat /etc/passwd | grep "/home/" | cut -d":" -f1 > /root/user.txt
mapfile -t username1 < /root/user.txt

declare -a username
declare -a jumlah
declare -a pid
i=0
for user in "${username1[@]}"; do
    username[$i]="$(echo "$user" | sed "s/'//g")"
    jumlah[$i]=0
    pid[$i]=""
    i=$((i + 1))
done

# Hitung sesi dropbear aktif per user
cat "$LOG" | grep -i dropbear | grep -i "Password auth succeeded" > /tmp/log-db.txt
proc=( $(ps aux | grep -i dropbear | awk '{print $2}') )
for PID in "${proc[@]}"; do
    cat /tmp/log-db.txt | grep "dropbear\[$PID\]" > /tmp/log-db-pid.txt
    NUM=$(cat /tmp/log-db-pid.txt | wc -l)
    USER=$(cat /tmp/log-db-pid.txt | awk '{print $10}' | sed "s/'//g")
    if [ "$NUM" -eq 1 ]; then
        i=0
        for user1 in "${username[@]}"; do
            if [ "$USER" = "$user1" ]; then
                jumlah[$i]=$((${jumlah[$i]} + 1))
                pid[$i]="${pid[$i]} $PID"
            fi
            i=$((i + 1))
        done
    fi
done

# Hitung sesi sshd aktif per user
cat "$LOG" | grep -i sshd | grep -i "Accepted password for" > /tmp/log-db.txt
data=( $(ps aux | grep "\[priv\]" | sort -k 72 | awk '{print $2}') )
for PID in "${data[@]}"; do
    cat /tmp/log-db.txt | grep "sshd\[$PID\]" > /tmp/log-db-pid.txt
    NUM=$(cat /tmp/log-db-pid.txt | wc -l)
    USER=$(cat /tmp/log-db-pid.txt | awk '{print $9}')
    if [ "$NUM" -eq 1 ]; then
        i=0
        for user1 in "${username[@]}"; do
            if [ "$USER" = "$user1" ]; then
                jumlah[$i]=$((${jumlah[$i]} + 1))
                pid[$i]="${pid[$i]} $PID"
            fi
            i=$((i + 1))
        done
    fi
done

# Eksekusi: hanya KICK PID yang melanggar, jangan hapus user atau restart service.
for i in "${!username[@]}"; do
    if [ "${jumlah[$i]}" -gt "$MAX" ]; then
        date_str=$(date +"%Y-%m-%d %X")
        echo "$date_str - ${username[$i]} - ${jumlah[$i]}"
        echo "$date_str - ${username[$i]} - ${jumlah[$i]}" >> /root/log-limit.txt
        # Kill spesifik PID yang sudah dilacak — TIDAK userdel, TIDAK restart service.
        for p in ${pid[$i]}; do
            kill -KILL "$p" >/dev/null 2>&1
        done
        pid[$i]=""
    fi
done

rm -f /tmp/log-db.txt /tmp/log-db-pid.txt
