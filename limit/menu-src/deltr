#!/bin/bash
# Delete akun Trojan. Lihat catatan fix di delvless.
# FIX TAMBAHAN: dulu sed range "/### $user $exp/,/^},{/d" pada .trojan.db
# menghapus dari baris match SAMPAI EOF karena .trojan.db tidak punya baris `},{`.
# Sekarang pakai single-line delete.
dateFromServer=$(curl -v --insecure --silent https://google.com/ 2>&1 | grep Date | sed -e 's/< Date: //')
biji=$(date +"%Y-%m-%d" -d "$dateFromServer")
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;36m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
red='\e[1;31m'
green='\e[0;36m'
green() { echo -e "\\033[32;1m${*}\\033[0m"; }
red() { echo -e "\\033[31;1m${*}\\033[0m"; }
clear


NUMBER_OF_CLIENTS=$(grep -c -E "^//tr " "/etc/xray/config.json")
if [[ ${NUMBER_OF_CLIENTS} == '0' ]]; then
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "         Hapus Akun Trojan             "
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    echo "Anda Tidak Memiliki Member Trojan"
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    read -n 1 -s -r -p "Press any key to back"
    m-trojan
fi

clear
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "          Hapus Akun Trojan            "
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo "  User       Expired  "
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
grep -E "^//tr " "/etc/xray/config.json" | cut -d ' ' -f 2-3 | column -t | sort | uniq
echo ""
red "tap enter to go back"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
read -rp "Ketik Usernamenya : " user

if [ -z "$user" ]; then
    m-trojan
    exit 0
fi

case "$user" in
    *[!a-zA-Z0-9_.-]*|''|'.'|'..'|*'/'*)
        echo "Username tidak valid."
        sleep 2
        m-trojan
        exit 0
        ;;
esac

exp=$(grep -E "^//tr ${user} " /etc/xray/config.json | head -n1 | cut -d ' ' -f 3)
if [ -z "$exp" ]; then
    echo "User TROJAN '$user' tidak ditemukan."
    sleep 2
    m-trojan
    exit 0
fi

u_esc=$(printf '%s' "$user" | sed 's/[].\/*^$[]/\\&/g')
e_esc=$(printf '%s' "$exp"  | sed 's/[].\/*^$[]/\\&/g')

sed -i "/^\/\/tr ${u_esc} ${e_esc}\$/,/^},{/d" /etc/xray/config.json
sed -i -E "/^### ${u_esc} ${e_esc}( |\$)/d" /etc/trojan/.trojan.db
rm -f "/etc/trojan/$user"
rm -f "/etc/kyt/limit/trojan/ip/$user"
rm -f "/var/www/html/trojan-$user.txt"

/usr/local/sbin/xyz-disconnect-user "$user" trojan >/dev/null 2>&1
systemctl reload xray > /dev/null 2>&1

clear
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo "  Akun Trojan Berhasil Di Hapus         "
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo " Client Name : $user"
echo " Expired On  : $exp"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
