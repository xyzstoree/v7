#!/bin/bash
# limit-ip - Auto-kick user yang melebihi IP-limit dengan ZERO-DROP user lain.
#
# Sebelumnya: edit config.json + `systemctl restart xray` → semua koneksi
# user lain ikut putus tiap kali ada satu user kena kick.
#
# Sekarang: panggil xyz-xray-user del (gRPC API) untuk men-deactivate user
# di runtime, dan xyz-disconnect-user untuk kick socket aktif user yang
# bersangkutan. Tidak ada restart/reload xray sama sekali.
#
# Selain itu, sed-pattern lama untuk vless/trojan menargetkan prefix yang
# salah (#& dan #! padahal DB & config sekarang pakai //vl, //tr, ###).
# Karena delete dari config.json sekarang dilakukan via API, kita tidak
# lagi mengandalkan prefix tersebut.

XRAY_USER_BIN="/usr/local/sbin/xyz-xray-user"
XYZ_DISCONNECT="/usr/local/sbin/xyz-disconnect-user"

send_log(){
  [[ -f /etc/bot/.bot.db ]] || return 0
  local CHATID KEY URL TEXT
  CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
  KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
  [[ -z "$CHATID" || -z "$KEY" ]] && return 0
  URL="https://api.telegram.org/bot$KEY/sendMessage"
  TEXT="
<code>────────────────────</code>
<b>⚠️ NOTIFICATIONS MULTI LOGIN ⚠️</b>
<code>────────────────────</code>
<code>Username  : </code><code>$user</code>
<code>Limit Ip    : </code><code>$data</code>
<code>────────────────────</code>
"
  curl -s --max-time 10 -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" "$URL" >/dev/null
}

# kick_user <proto> <user>
# Hapus user dari config.json (untuk persistence) + runtime Xray (live, no restart)
# + putus paksa socket aktif. Aman dipanggil idempoten.
kick_user() {
    local proto="$1" user="$2" exp marker u_esc e_esc db
    case "$proto" in
        vmess)  marker="//vm"; db="/etc/vmess/.vmess.db" ;;
        vless)  marker="//vl"; db="/etc/vless/.vless.db" ;;
        trojan) marker="//tr"; db="/etc/trojan/.trojan.db" ;;
        *) return ;;
    esac
    exp=$(grep -E "^${marker} ${user} " /etc/xray/config.json | head -n1 | cut -d ' ' -f 3)
    u_esc=$(printf '%s' "$user" | sed 's/[].\/*^$[]/\\&/g')
    e_esc=$(printf '%s' "$exp"  | sed 's/[].\/*^$[]/\\&/g')
    m_esc=$(printf '%s' "$marker" | sed 's|/|\\/|g')

    if [ -n "$exp" ]; then
        sed -i "/^${m_esc} ${u_esc} ${e_esc}\$/,/^},{/d" /etc/xray/config.json
    fi
    [ -f "$db" ] && sed -i -E "/^### ${u_esc}( |\$)/d" "$db"

    # Live deactivate via API (no restart).
    [ -x "$XRAY_USER_BIN" ] && "$XRAY_USER_BIN" del "$proto" "$user" >/dev/null 2>&1
    [ -x "$XYZ_DISCONNECT" ] && "$XYZ_DISCONNECT" "$user" "$proto" >/dev/null 2>&1
}

vmip(){
while true; do
  echo -n > /var/log/xray/access.log
  sleep 60
  [[ -d /etc/kyt/limit/vmess/ip ]] || { sleep 30; continue; }
  data=( $(ls /etc/kyt/limit/vmess/ip 2>/dev/null) )
  for user in "${data[@]}"; do
    iplimit=$(cat /etc/kyt/limit/vmess/ip/$user 2>/dev/null)
    ehh=$(grep "$user" /var/log/xray/access.log 2>/dev/null | awk '{print $3}' | sed 's/tcp://g' | cut -d ":" -f 1 | sort -u)
    [[ -z "$ehh" ]] && continue
    cekcek=$(echo -e "$ehh" | wc -l)
    if [[ $cekcek -gt ${iplimit:-99} ]]; then
      kick_user vmess "$user"
      rm -f /etc/kyt/limit/vmess/ip/$user
      send_log
    fi
    sleep 0.1
  done
  sleep 30
done
}

