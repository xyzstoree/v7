#!/bin/bash
# limit-ip - FIXED: correct sed patterns for vless (#&) and trojan (#!)

send_log(){
  [[ -f /etc/bot/.bot.db ]] || return 0
  local CHATID KEY URL TEXT
  CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
  KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
  [[ -z "$CHATID" || -z "$KEY" ]] && return 0
  URL="https://api.telegram.org/bot$KEY/sendMessage"
  TEXT="
<code>────────────────────</code>
<b>⚠️ NOTIFICATIONS MULTI LOGIN ⚠️</b>
<code>────────────────────</code>
<code>Username  : </code><code>$user</code>
<code>Limit Ip    : </code><code>$data</code>
<code>────────────────────</code>
"
  curl -s --max-time 10 -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" "$URL" >/dev/null
}

vmip(){
while true; do
  echo -n > /var/log/xray/access.log
  sleep 60
  [[ -d /etc/kyt/limit/vmess/ip ]] || { sleep 30; continue; }
  data=( $(ls /etc/kyt/limit/vmess/ip 2>/dev/null) )
  for user in "${data[@]}"; do
    iplimit=$(cat /etc/kyt/limit/vmess/ip/$user 2>/dev/null)
    ehh=$(grep "$user" /var/log/xray/access.log 2>/dev/null | awk '{print $3}' | sed 's/tcp://g' | cut -d ":" -f 1 | sort -u)
    [[ -z "$ehh" ]] && continue
    cekcek=$(echo -e "$ehh" | wc -l)
    if [[ $cekcek -gt ${iplimit:-99} ]]; then
      exp=$(grep -w "^### $user" "/etc/xray/config.json" | awk '{print $3}' | sort -u)
      sed -i "/^### $user $exp/,/^},{/d" /etc/xray/config.json
      sed -i "/^### $user $exp/d" /etc/vmess/.vmess.db
      systemctl restart xray >/dev/null 2>&1
      rm -f /etc/kyt/limit/vmess/ip/$user
      send_log
    fi
    sleep 0.1
  done
  sleep 30
done
}

